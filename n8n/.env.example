# Copy to n8n/.env (gitignored). Generate each secret with: openssl rand -hex 32

# Convex signs webhooks to n8n with this; n8n verifies.
CONVEX_TO_N8N_SECRET=
# n8n signs its calls to Convex with this; Convex verifies. Different on purpose.
N8N_TO_CONVEX_SECRET=
# Where n8n reaches Convex HTTP actions. Local backend on the host:
#   http://host.docker.internal:3211
# Convex cloud: https://<deployment>.convex.site
CONVEX_SITE_URL=http://host.docker.internal:3211
# Encrypts n8n credentials at rest. Generate once, never change: openssl rand -hex 24
N8N_ENCRYPTION_KEY=
