# Next.js app (.env.local). `npx convex dev` writes the CONVEX_* lines for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Convex deployment env vars are NOT read from this file. Set them with
# `npx convex env set NAME value` (see README):
#   CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL
#   N8N_REQUEST_WEBHOOK_URL   http://localhost:5678/webhook/lendloop-request-event
#   CONVEX_TO_N8N_SECRET      same value as in n8n/.env
#   N8N_TO_CONVEX_SECRET      same value as in n8n/.env
